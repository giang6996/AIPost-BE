{
  "compilerOptions": {
    "types": ["node", "vitest/globals"],
    "resolveJsonModule": true,

    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",

    "rootDir": ".",
    "outDir": "./dist",

    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
  },
  "include": ["src", "prisma/seeds"],
  "exclude": ["node_modules", "dist"]
}